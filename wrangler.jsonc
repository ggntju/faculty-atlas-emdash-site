{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "faculty-atlas-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "faculty-atlas-emdash-site","database_id": "e60efebc-5fb2-4b41-ab27-24c6753dbf3b",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "faculty-atlas-emdash-media","preview_bucket_name": "faculty-atlas-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"send_email": [{ "name": "EMAIL" }],
	"worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
}
